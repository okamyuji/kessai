package templates

import (
	"fmt"

	"github.com/okamyuji/kessai/internal/platform/money"
)

// TokushoSnapshot 特商法6項目のスナップショット
type TokushoSnapshot struct {
	Portion              string // 分量
	PriceWithShipping    string // 販売価格（送料含む）
	PaymentTiming        string // 支払の時期と方法
	DeliveryTiming       string // 引渡し時期
	ApplicationPeriod    string // 申込期間の定めがある場合はその旨
	WithdrawalAndReturns string // 申込みの撤回・解除に関する事項
}

// ProductView 購入対象商品のビュー
type ProductView struct {
	ID    string
	Name  string
	Price money.JPY
}

// CheckoutPage 購入導線の起点。特商法6項目を最終確認画面と同じ順で常時表示する（FR-D2）。
templ CheckoutPage(publishableKey string, product ProductView, tokusho TokushoSnapshot, csrfToken string) {
	@Layout("購入", publishableKey) {
		<section class="rounded-lg bg-white p-6 shadow">
			<h1 class="text-xl font-bold mb-4">{ product.Name }</h1>
			<div class="text-2xl font-bold mb-6">{ product.Price.String() }</div>
			<p class="text-sm text-slate-600 mb-4">
				カード情報は当サービスを経由せず、Stripeへ直接送信されます（PCI DSS SAQ A構成）。
			</p>
			<form method="POST" action="/checkout" hx-boost="false" class="space-y-3">
				@CSRFInput(csrfToken)
				<input type="hidden" name="product_id" value={ product.ID }/>
				<button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white font-bold w-full">
					カード情報の入力へ進む
				</button>
			</form>
		</section>
		@TokushoBlock(tokusho)
	}
}

// ConfirmPage 3DS認証を含む決済の完了ページ。Stripe.js（confirmPayment）をブラウザ側で呼びます。
templ ConfirmPage(publishableKey, clientSecret, paymentID string, product ProductView, tokusho TokushoSnapshot) {
	@Layout("お支払い", publishableKey) {
		<section class="rounded-lg bg-white p-6 shadow">
			<h1 class="text-xl font-bold mb-4">お支払い</h1>
			<div class="mb-4 text-sm text-slate-600">
				<div>{ product.Name }</div>
				<div class="font-bold text-lg">{ product.Price.String() }</div>
				<div class="text-xs">決済ID: <code>{ paymentID }</code></div>
			</div>
			// Stripe Elements を差し込むための空要素
			<div id="payment-element" class="mb-4"></div>
			<button id="pay-btn" class="px-4 py-2 rounded bg-emerald-600 text-white font-bold w-full">
				カード情報を入力して確定する
			</button>
			<div id="pay-error" class="mt-3 text-sm text-rose-600"></div>
			// Stripe.js初期化はテンプレ末尾のscriptで（CSPでself+jsdotstripedotcomのみ許可）
			<script src="/static/stripe-init.js" defer data-client-secret={ clientSecret }></script>
		</section>
		@TokushoBlock(tokusho)
	}
}

// CompletePage 決済完了の受領画面
templ CompletePage(paymentID string) {
	@Layout("お支払い完了", "") {
		<section class="rounded-lg bg-white p-6 shadow">
			<h1 class="text-xl font-bold mb-2">お支払いを受け付けました</h1>
			<p class="text-sm text-slate-600">
				決済ID: <code>{ paymentID }</code>
			</p>
		</section>
	}
}

// TokushoBlock 特商法6項目の常時表示ブロック
templ TokushoBlock(t TokushoSnapshot) {
	<section class="mt-8 rounded-lg bg-white p-6 shadow text-sm">
		<h2 class="font-bold mb-3">最終確認事項（特定商取引法6項目）</h2>
		<dl class="grid grid-cols-1 gap-y-2 sm:grid-cols-3">
			@labeledRow("分量", t.Portion)
			@labeledRow("販売価格（送料込み）", t.PriceWithShipping)
			@labeledRow("支払の時期と方法", t.PaymentTiming)
			@labeledRow("引渡し時期", t.DeliveryTiming)
			@labeledRow("申込期間の定め", fallback(t.ApplicationPeriod, "定めなし"))
			@labeledRow("撤回・解除に関する事項", t.WithdrawalAndReturns)
		</dl>
	</section>
}

templ labeledRow(label, value string) {
	<dt class="sm:col-span-1 font-semibold text-slate-500">{ label }</dt>
	<dd class="sm:col-span-2">{ value }</dd>
}

// TokushoPage 独立ページとしての特商法表記（footerからリンク）
templ TokushoPage(t TokushoSnapshot) {
	@Layout("特定商取引法に基づく表記", "") {
		@TokushoBlock(t)
	}
}

// helper 空文字を既定値へ
func fallback(v, def string) string {
	if v == "" {
		return def
	}
	return v
}

// _ 未使用パッケージ回避（fmtは今後の拡張余地として保持）
var _ = fmt.Sprintf
