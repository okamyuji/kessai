# kessai のローカル環境変数サンプル。.env にコピーするとstripe-mockへ接続します（.env はgit管理外）。
DATABASE_URL=postgres://kessai:kessai_dev@localhost:5433/kessai?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_MOCK_URL=http://127.0.0.1:12111
CAPTURE_MODE=manual
CHECKOUT_EXPIRY_MINUTES=60
AUTH_EXPIRY_DAYS=21
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=please-change-me
SESSION_SIGNING_KEY=change-me-32bytes-random-string
