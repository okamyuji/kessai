# kessai の環境変数サンプル。実運用は .env にコピーして値を埋めます（.env はgit管理外）。
DATABASE_URL=postgres://kessai:kessai_dev@localhost:5433/kessai?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_PUBLISHABLE_KEY
CAPTURE_MODE=manual
CHECKOUT_EXPIRY_MINUTES=60
AUTH_EXPIRY_DAYS=21
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=please-change-me
SESSION_SIGNING_KEY=change-me-32bytes-random-string
